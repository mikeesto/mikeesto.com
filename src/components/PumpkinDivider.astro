---
const pumpkins = [
  { tilt: "-9deg", width: 43, height: 49, color: "#e98438" },
  { tilt: "7deg", width: 49, height: 42, color: "#ed8c40" },
  { tilt: "-4deg", width: 53, height: 53, color: "#e77c32" },
  { tilt: "6deg", width: 48, height: 46, color: "#ee9145" },
  { tilt: "-8deg", width: 33, height: 40, color: "#e98438" },
];
---

<div class="pumpkin-divider" aria-hidden="true">
  {pumpkins.map((pumpkin, index) => (
    <svg
      class="pumpkin"
      width={pumpkin.width}
      height={pumpkin.height}
      viewBox="0 0 64 64"
      fill="none"
      focusable="false"
      style={`--tilt: ${pumpkin.tilt}`}
    >
      <path d="M29 14 Q27 7 32 4 L37 5 Q33 9 35 15" fill="#65523b" />
      <path
        d="M32 14 C18 7 4 20 5 37 C5 53 16 61 31 58 C46 62 59 52 59 36 C60 20 46 8 32 14Z"
        fill={pumpkin.color}
        stroke="#cc682c"
        stroke-width="1.3"
      />
      <path d="M23 17 C15 26 15 46 23 54 M42 17 C49 27 48 45 41 54" stroke="#bd6026" stroke-opacity=".25" stroke-width="1.5" stroke-linecap="round" />
      <g fill="#302b26">
        {index === 0 ? (
          <>
            <path d="M14 30 Q19 23 24 30 Q19 28 14 30 M39 30 Q44 23 49 30 Q44 28 39 30" />
            <path d="M23 38 Q31 32 40 38 Q37 49 31 46 Q25 47 23 38" />
          </>
        ) : index === 1 ? (
          <>
            <ellipse cx="20" cy="29" rx="6" ry="7" />
            <ellipse cx="43" cy="28" rx="6" ry="6" />
            <path d="M18 40 Q31 45 47 38 Q43 54 31 52 Q22 51 18 40" />
            <path d="M29 40 L29 45 L35 45 L35 40" fill={pumpkin.color} />
          </>
        ) : index === 2 ? (
          <>
            <ellipse cx="19" cy="28" rx="6" ry="7" transform="rotate(-12 19 28)" />
            <ellipse cx="44" cy="27" rx="7" ry="7" />
            <path d="M25 39 Q32 36 39 39 Q37 48 32 48 Q26 47 25 39" />
          </>
        ) : index === 3 ? (
          <>
            <path d="M18 22 Q25 19 25 32 L16 32Z M40 22 Q47 19 48 32 L39 32Z" />
            <path d="M17 41 Q23 35 28 41 Q32 46 37 40 Q43 35 48 40 Q46 49 40 47 Q32 56 25 47 Q19 49 17 41" />
          </>
        ) : (
          <>
            <ellipse cx="21" cy="29" rx="4" ry="7" />
            <ellipse cx="43" cy="29" rx="4" ry="7" />
            <path d="M23 40 Q32 45 42 39 Q40 52 33 52 Q26 52 23 40" />
          </>
        )}
      </g>
    </svg>
  ))}
</div>

<style>
  .pumpkin-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 32px auto 36px;
  }

  .pumpkin {
    flex-shrink: 0;
    overflow: visible;
    transform: rotate(var(--tilt));
    transform-origin: center 85%;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pumpkin:hover {
      animation: wobble 450ms ease-in-out;
    }
  }

  @keyframes wobble {
    0%, 100% { transform: rotate(var(--tilt)); }
    35% { transform: rotate(calc(var(--tilt) + 9deg)); }
    70% { transform: rotate(calc(var(--tilt) - 7deg)); }
  }

  @media (min-width: 768px) {
    .pumpkin-divider {
      display: none;
    }
  }
</style>
