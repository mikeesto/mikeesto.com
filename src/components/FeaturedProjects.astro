---
import IconComponent from "./Icon.astro";
import { Youtube, Grid2x2, Mic, Palette } from "lucide";

const icons = {
  Grid2x2,
  Mic,
  Youtube,
  Palette,
};

type Project = {
  title: string;
  description: string;
  color: string;
  hoverColor: string;
  textColor: string;
  icon: keyof typeof icons;
  link: string;
};

const projects = [
  {
    title: "Kind Wordle",
    description:
      "A kinder version of Wordle that reveals the vowels from the start.",
    color: "bg-blue-100/70",
    hoverColor: "group-hover:bg-blue-50/70",
    textColor: "text-blue-900",
    icon: "Grid2x2",
    link: "https://kindwordle.netlify.app/",
  },
  {
    title: "Gemini Transcribe",
    description: "Transcribe audio and video files with speaker diarisation.",
    color: "bg-emerald-100/70",
    hoverColor: "group-hover:bg-emerald-50/70",
    textColor: "text-emerald-900",
    icon: "Mic",
    link: "https://gemini-transcribe.fly.dev/",
  },
  {
    title: "YouTube Summariser",
    description: "Generate a summary of a YouTube video.",
    color: "bg-amber-100/70",
    hoverColor: "group-hover:bg-amber-50/70",
    textColor: "text-amber-900",
    icon: "Youtube",
    link: "https://yt-summary.vercel.app/",
  },
  {
    title: "Emoji Maker",
    description:
      "Design your own silly custom emoji. Very popular with my friends' kids.",
    color: "bg-purple-100/70",
    hoverColor: "group-hover:bg-purple-50/70",
    textColor: "text-purple-900",
    icon: "Palette",
    link: "https://emojimakers.netlify.app/",
  },
] satisfies Project[];
---

<section aria-label="Selected projects">
  <div
    class="relative grid grid-cols-1 gap-x-8 md:grid-cols-2 md:before:pointer-events-none md:before:absolute md:before:inset-y-0 md:before:left-1/2 md:before:z-10 md:before:w-px md:before:-translate-x-1/2 md:before:bg-black/15 md:after:pointer-events-none md:after:absolute md:after:inset-x-0 md:after:top-1/2 md:after:z-10 md:after:h-px md:after:-translate-y-1/2 md:after:bg-black/15"
  >
    {
      projects.map((project, index) => {
        const Icon = icons[project.icon];
        return (
          <a
            href={project.link}
            class={`group relative flex gap-4 rounded-xl px-3 py-5 transition-colors duration-200 md:-mx-3 md:border-0 ${index > 0 ? "border-t border-black/15" : ""} ${project.hoverColor} focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2`}
            aria-label={`${project.title} - ${project.description}`}
          >
            <div
              class={`mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg [&>svg]:!mb-0 [&>svg]:!h-5 [&>svg]:!w-5 ${project.color} ${project.textColor}`}
              aria-hidden="true"
            >
              <IconComponent icon={Icon} stroke-width={1.75} />
            </div>

            <div class="min-w-0">
              <h3
                class={`mb-1 text-base font-semibold leading-6 ${project.textColor} decoration-2 underline-offset-4 group-hover:underline`}
              >
                {project.title}
              </h3>
              <p class="text-sm leading-6 text-gray-600">
                {project.description}
              </p>
            </div>
          </a>
        );
      })
    }
  </div>

  <div class="mt-4">
    <a
      href="/projects"
      class="group inline-flex items-center gap-2 text-sm font-medium text-blue-500 transition-colors hover:text-blue-600"
    >
      <span
        class="underline decoration-blue-200 decoration-2 underline-offset-4 group-hover:decoration-blue-500"
      >
        Browse all projects
      </span>
      <span
        class="transition-transform duration-200 group-hover:translate-x-1"
        aria-hidden="true"
      >
        →
      </span>
    </a>
  </div>
</section>
